# ── قاعدة البيانات ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bader_aid?schema=public"

# ── المصادقة (Auth.js v5) ──
AUTH_SECRET="ضع هنا ناتج: npx auth secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ── تخزين المرفقات (متوافق مع S3) ──
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
S3_ENDPOINT=""
S3_REGION="me-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── المهام المجدولة (BullMQ) ──
REDIS_URL="redis://127.0.0.1:6379"

# ── الإشعارات (المرحلة الرابعة) ──
# log = يسجّل ولا يرسل (التطوير) · whatsapp · sms
NOTIFICATIONS_DRIVER="log"
NOTIFICATIONS_ENABLED="true"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
SMS_ENDPOINT=""
SMS_API_KEY=""
SMS_SENDER="BADER"
